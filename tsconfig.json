{
  "compilerOptions": {
    "target": "ES2020",         /* В яку версію JS компілювати */
    "module": "NodeNext",      /* Сучасна система модулів для Node */
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,   /* Для сумісності import/require */
    "forceConsistentCasingInFileNames": true,
    "strict": true,            /* Вмикає всі суворі перевірки - це важливо */
    "skipLibCheck": true,      /* Не перевіряти типи у бібліотеках */
    "outDir": "./dist"         /* Куди складати скомпільовані .js файли */
  },
  "include": ["src/**/*"]      /* Які файли компілювати */
}